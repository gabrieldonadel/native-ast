{
  "name": "native-ast",
  "version": "0.0.2",
  "description": "Swift and Kotlin AST traversal from TypeScript, for Expo config plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrieldonadel/native-ast.git"
  },
  "keywords": [
    "ast",
    "tree-sitter",
    "swift",
    "kotlin",
    "expo",
    "config-plugins",
    "codemod"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tree-sitter-swift.wasm": "./tree-sitter-swift.wasm",
    "./tree-sitter-kotlin.wasm": "./tree-sitter-kotlin.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "tree-sitter-swift.wasm",
    "tree-sitter-kotlin.wasm",
    "scanner-calloc.patch",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/api/",
    "test:native": "NATIVE_AST_BACKEND=native node --test test/api/",
    "smoke": "node test/smoke.js wasm",
    "smoke:native": "node test/smoke.js native",
    "grammar-sync": "node test/grammar-sync.js",
    "plugins": "node test/config-plugins/run.js wasm",
    "plugins:native": "node test/config-plugins/run.js native",
    "swift:native": "node test/compare.js native",
    "swift:wasm": "node test/compare.js wasm",
    "kotlin:native": "node test/compare-kotlin.js native",
    "kotlin:wasm": "node test/compare-kotlin.js wasm",
    "bench": "node test/bench.js",
    "probe": "node test/probe-hash.js ./tree-sitter-swift.wasm",
    "build:wasm": "./build-wasm.sh"
  },
  "dependencies": {
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.9",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-swift": "0.7.1"
  }
}
