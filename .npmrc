# Both Kotlin and Swift grammar packages declare `tree-sitter` peer ranges that
# lag the runtime (^0.22.4 and ^0.22.1 against 0.25.1), so a plain `npm i`
# fails with ERESOLVE. The native binding is only a devDependency here, used to
# diff the WASM parsers against native; the runtime dependency is
# `web-tree-sitter`, which has no such conflict.
legacy-peer-deps=true
